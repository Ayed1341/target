# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Alpaca (paper trading by default) -------------------------------------
# Create free keys at https://alpaca.markets  ->  "Paper Trading" account.
ALPACA_API_KEY=your_paper_key_here
ALPACA_API_SECRET=your_paper_secret_here
# Paper endpoint. Switch to https://api.alpaca.markets ONLY for real money.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Telegram alert bot (for manual trading on Abyan) ----------------------
# 1. Talk to @BotFather on Telegram -> /newbot -> get the token.
# 2. Send your bot a message, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Strategy settings -----------------------------------------------------
# Comma-separated symbols. Alpaca uses US tickers (AAPL, MSFT...).
# For the Abyan signal bot you can use any yfinance-supported symbol
# (e.g. 2222.SR for Saudi Aramco on Tadawul).
SYMBOLS=AAPL,MSFT,SPY
# Bar timeframe for analysis: 1d, 1h, 15m ...
TIMEFRAME=1d
# How many of the 16 strategies must agree before a BUY/SELL is emitted.
SIGNAL_THRESHOLD=6
# Max % of buying power to deploy per position (live mode only).
MAX_POSITION_PCT=5
