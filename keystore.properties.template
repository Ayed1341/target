# Copy this file to "keystore.properties" (same folder) and fill in your values
# to sign RELEASE builds with your own key. If this file is absent, release
# builds are automatically signed with the debug key so the project still builds.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore ayed-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias ayed
#
storeFile=ayed-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=ayed
keyPassword=YOUR_KEY_PASSWORD
